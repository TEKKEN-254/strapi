{
  "kind": "collectionType",
  "collectionName": "categories",
  "info": {
    "singularName": "category",
    "pluralName": "categories",
    "displayName": "Category"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true,
      "maxLength": 50,
      "minLength": 3,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "regex": "^[a-zA-Z0-9\\s-]{3,50}$"
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true,
      "minLength": 3,
      "maxLength": 50
    },
    "posts": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::post.post",
      "mappedBy": "category"
    }
  }
}
